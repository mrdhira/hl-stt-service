# Copy to .env.local (git-ignored). No secrets here — this is a LAN-only POC.

# Where the API lives. Empty = same origin, which is what you want both behind
# Caddy and in `npm run dev` (the dev server proxies to VITE_DEV_BACKEND).
VITE_API_BASE=

# Dev-server proxy target. Only read by vite.config.ts, never shipped.
VITE_DEV_BACKEND=http://localhost:8000

# Capture rate for the Stream tab. The backend resamples anyway, but 16 kHz
# matches the models and keeps the websocket cheap.
VITE_STREAM_SAMPLE_RATE=16000

# Rows requested by the Reports tab.
VITE_RUNS_LIMIT=100
