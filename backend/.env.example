# Rename to .env and fill in — .env is git-ignored, never commit it.
# POC: local, offline. No secrets required. These are just tuning knobs.

STT_HOST=0.0.0.0
STT_PORT=8000
STT_MODELS_DIR=/data/models
STT_BACKEND_SENSEVOICE=sense-voice-zh-en-ja-ko-yue
STT_BACKEND_QWEN=qwen3-asr
STT_BACKEND_WHISPER=whisper
STT_NUM_THREADS=4
STT_LOG_LEVEL=INFO
